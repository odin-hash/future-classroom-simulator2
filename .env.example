# ============================================
# Future Classroom Simulator — Environment Variables
# ============================================

# ── AI Providers (cascade: Gemini → Groq → Ollama → Templates) ──
# Set at least ONE of these for AI-powered student responses.
# If none are set, personality-aware template fallbacks are used.

# Google Gemini 2.0 Flash (primary)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud — Llama 3.3 70B (fast fallback, free tier: 30 req/min)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Ollama — Local LLM (unlimited, runs on your machine)
# Install: https://ollama.com → run: ollama pull llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ── Database ──
# Optional: defaults to SQLite locally
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Speech Recognition (STT) ──
# Optional: Google Cloud service account credentials as JSON string (ideal for serverless like Render)
# GOOGLE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "...", ...}'
# Or classic file-path based credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# ── Local / Offline Development ──
# Set to 'true' to allow running backend tests or mock offline sessions without GEMINI_API_KEY
ALLOW_MOCK_LLM=false

# ── Frontend ──
# Optional: set at build time for production deployment
# VITE_API_URL=https://your-backend-url.onrender.com

